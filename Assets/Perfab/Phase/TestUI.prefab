  m_Name: 
  m_EditorClassIdentifier: 
  value: {fileID: 8884148336929804758}
  Introduction: {fileID: 4241351106480375642}
  testCanvas: {fileID: 4042659198643790462}
  currentMode: 0
  headingText: {fileID: 1572503752952091381}
  instructionText: {fileID: 3793626266536219323}
  eyeTrackingHeading: Eye Tracking Test
  hybridHeading: Hybrid Interaction Test
  eyeTrackingInstruction: 'You will be given a sequence of numbers (code) to enter.


    To
    select a number, look at it. When you focus on a number, a dwell animation will
    begin.


    Keep looking at the number until the dwell completes. The number
    will then flicker, indicating that your selection has been confirmed.


    Repeat
    this process until the full code is entered.'
  hybridInstruction: 'You will be given a sequence of numbers (code) to enter.


    To
    select a number, look at it. When you focus on a number, a dwell animation will
    begin.


    After the dwell completes, the number will flicker. However, your
    selection will only be confirmed when a validation signal is received from the
    system.


    If the selection is not confirmed, the number will flicker again.
    Continue focusing and repeating the flicker until confirmation occurs.


    Repeat
    this process until the full code is entered.'
